{
  "name": "system-name-calculator-ts",
  "version": "1.0.0",
  "description": "No Man's Sky system/region name generator and reverse-search from coordinates. TypeScript port of C# SystemNameCalculator.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && cp src/data/letter-map.json dist/data/",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "no-mans-sky",
    "nms",
    "procedural-generation",
    "name-generator",
    "coordinates"
  ],
  "author": "MiMo V2.5",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.4.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
